  <!-- ===== Minimal vanilla JS (no dependencies) ===== -->
  <script>
  //<![CDATA[
  (function(){
    var d=document,w=window;
    // Year + today date
    var y=d.getElementById('year');if(y)y.textContent=new Date().getFullYear();
    var td=d.getElementById('todayDate');if(td)td.textContent=new Date().toLocaleDateString(d.documentElement.lang||'en',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
    // Dark mode toggle (persisted)
    var root=d.documentElement,tt=d.getElementById('themeToggle');
    function setTheme(t){root.setAttribute('data-theme',t);try{localStorage.setItem('theme',t)}catch(e){}if(tt)tt.innerHTML=t==='dark'?'&#9728; Light':'&#9790; Dark';}
    var saved=null;try{saved=localStorage.getItem('theme')}catch(e){}
    if(saved)setTheme(saved);else if(w.matchMedia&&w.matchMedia('(prefers-color-scheme: dark)').matches&&tt)tt.innerHTML='&#9728; Light';
    if(tt)tt.addEventListener('click',function(){setTheme(root.getAttribute('data-theme')==='dark'?'light':'dark');});
    // Mobile nav
    var t=d.getElementById('navToggle'),n=d.getElementById('site-nav');
    if(t&&n){t.addEventListener('click',function(){var o=n.classList.toggle('open');t.setAttribute('aria-expanded',o);});}
    // Reading progress + back to top
    var b=d.getElementById('toTop'),pr=d.getElementById('progress'),body=d.getElementById('post-body');
    w.addEventListener('scroll',function(){
      if(b)b.classList.toggle('show',w.scrollY>500);
      if(pr&&body){var r=body.getBoundingClientRect(),h=body.offsetHeight-w.innerHeight,p=h>0?Math.min(100,Math.max(0,(-r.top/h)*100)):0;pr.style.width=p+'%';}
    },{passive:true});
    if(b)b.addEventListener('click',function(){w.scrollTo({top:0,behavior:'smooth'});});
    // Read time (approx 220 wpm from body length)
    var rt=d.querySelectorAll('.read-time');
    for(var k=0;k<rt.length;k++){var len=parseInt(rt[k].getAttribute('data-body-length'),10)||0;var mins=Math.max(1,Math.round(len/6/220));rt[k].textContent=mins+' min read';}
    // Copy link
    var cl=d.querySelector('.copy-link');
    if(cl)cl.addEventListener('click',function(e){e.preventDefault();var u=cl.getAttribute('data-url');if(navigator.clipboard){navigator.clipboard.writeText(u).then(function(){cl.textContent='\u2713';setTimeout(function(){cl.innerHTML='&#128279;'},1500);});}});
    // Lazy-load post media
    var imgs=d.querySelectorAll('.post-body img');
    for(var i=0;i<imgs.length;i++){imgs[i].setAttribute('loading','lazy');imgs[i].removeAttribute('width');imgs[i].removeAttribute('height');imgs[i].style.width='';imgs[i].style.height='';}
    var fr=d.querySelectorAll('.post-body iframe');for(var j=0;j<fr.length;j++){fr[j].setAttribute('loading','lazy');}
    // Breaking ticker: fill with latest 6 posts via Blogger JSON feed, duplicate for seamless loop
    var tl=d.getElementById('tickerList');
    if(tl){
      w.__ticker=function(res){var e=res.feed.entry||[],h='';for(var a=0;a<e.length;a++){var l='';for(var q=0;q<e[a].link.length;q++){if(e[a].link[q].rel==='alternate'){l=e[a].link[q].href;break;}}h+='<li><a href="'+l+'">'+e[a].title.$t+'</a></li>';}if(h){tl.innerHTML=h+h;}};
      var sc=d.createElement('script');sc.src='/feeds/posts/summary?alt=json-in-script&max-results=6&callback=__ticker';d.body.appendChild(sc);
    }
    // Related stories by first label (3 items, excludes current post)
    var rg=d.getElementById('relatedGrid');
    if(rg){
      var lab=rg.getAttribute('data-label'),self=rg.getAttribute('data-self');
      w.__related=function(res){var e=res.feed.entry||[],h='',c=0;for(var a=0;a<e.length&&c<3;a++){var id=e[a].id.$t.split('post-')[1];if(id===self)continue;var l='';for(var q=0;q<e[a].link.length;q++){if(e[a].link[q].rel==='alternate'){l=e[a].link[q].href;break;}}var im=e[a].media$thumbnail?e[a].media$thumbnail.url.replace(/\/s72(-c)?\//,'/w400-h225-p-k-no-nu/'):'';h+='<a class="item" href="'+l+'">'+(im?'<img alt="" loading="lazy" src="'+im+'" width="400" height="225"/>':'')+'<h3>'+e[a].title.$t+'</h3></a>';c++;}if(h)rg.innerHTML=h;else rg.parentNode.style.display='none';};
      var sr=d.createElement('script');sr.src='/feeds/posts/summary/-/'+encodeURIComponent(lab)+'?alt=json-in-script&max-results=4&callback=__related';d.body.appendChild(sr);
    }
  })();
  //]]>
  </script>
